# New video-hosting configuration. Merge with the deployment's existing environment.
# Keep the existing database, authentication, payments, Bunny, and Redis settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact backend URL, including the API prefix used in src/app.ts:
GOOGLE_REDIRECT_URI=https://your-backend.example/api/v1/course/video/oauth/callback
YOUTUBE_CHANNEL_ID=
# Generate 32 cryptographically random bytes and base64 encode them.
# Store in your secret manager; keep stable across API and worker replicas.
VIDEO_TOKEN_ENCRYPTION_KEY=
# Private persistent volume, shared by every API and video-worker replica.
# Never serve this path through Express, a public bucket, or the frontend.
VIDEO_TEMP_DIR=/var/lib/aloskill/private-video-uploads
VIDEO_WORKER_CONCURRENCY=2
# Queue uses the already-existing REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, REDIS_TLS.
